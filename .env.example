# Copy to .env, or run python scripts/init_local.py to generate a token.
APP_ACCESS_TOKEN=
# Optional; default is an absolute SQLite URL pointing to storage/tracker.db.
# DATABASE_URL=sqlite:////absolute/path/to/tracker.db
# Optional server-side proxy target; never put a token in NEXT_PUBLIC_* variables.
# API_BASE_URL=http://127.0.0.1:8000

# Optional, owner-approved development-copy status writes. Unset keeps read-only.
# Setting this requests the broader Sheets scope on the next Google connection.
# SHEETS_WRITE_COPY_ID=your-approved-development-copy-id

# Public Greenhouse fetching, only after reviewing source terms; merge with existing approved hosts.
# URL_FETCH_ALLOWED_HOSTS=boards-api.greenhouse.io,job-boards.greenhouse.io

# Optional local structured requirement extraction (install/test the model first).
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# Optional Reed API aggregator; set the real key only in private .env.
# REED_API_KEY=
# Merge www.reed.co.uk into existing URL_FETCH_ALLOWED_HOSTS after reviewing API terms.
