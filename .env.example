# Copy to .env, or run python scripts/init_local.py to generate a token.
APP_ACCESS_TOKEN=
# Optional; default is an absolute SQLite URL pointing to storage/tracker.db.
# DATABASE_URL=sqlite:////absolute/path/to/tracker.db
# Optional server-side proxy target; never put a token in NEXT_PUBLIC_* variables.
# API_BASE_URL=http://127.0.0.1:8000
